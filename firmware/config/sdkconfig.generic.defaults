# Safe build profile: no board GPIOs, SD, physical pedometer or public test trust.
CONFIG_DIGIVICE_BOARD_GENERIC_SERIAL=y
# CONFIG_DIGIVICE_BOARD_WAVESHARE_146 is not set
# CONFIG_DIGIVICE_BOARD_HELTEC_UNVERIFIED is not set
# CONFIG_DIGIVICE_SD_ASSETS is not set
# CONFIG_DIGIVICE_QMI_PEDOMETER is not set
# CONFIG_DIGIVICE_DEVELOPMENT_ASSETS is not set
# CONFIG_DIGIVICE_ALLOW_PRIVATE_HTTP is not set
