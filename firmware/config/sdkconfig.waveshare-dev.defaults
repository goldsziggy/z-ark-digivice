# Development build only. The RFC6979 asset signing key is publicly known.
# This enables no Wi-Fi credentials or endpoint; HTTP needs runtime opt-in too.
# CONFIG_DIGIVICE_BOARD_GENERIC_SERIAL is not set
CONFIG_DIGIVICE_BOARD_WAVESHARE_146=y
# CONFIG_DIGIVICE_BOARD_HELTEC_UNVERIFIED is not set
CONFIG_DIGIVICE_SD_ASSETS=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=128
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_EXFAT=y
# CONFIG_DIGIVICE_QMI_PEDOMETER is not set
CONFIG_DIGIVICE_DEVELOPMENT_ASSETS=y
CONFIG_DIGIVICE_ALLOW_PRIVATE_HTTP=y

CONFIG_DIGIVICE_PRIVATE_SD_ART=y
