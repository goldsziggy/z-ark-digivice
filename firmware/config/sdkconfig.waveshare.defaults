# Waveshare ESP32-S3-Touch-LCD-1.46 standard glass, SKU29565.
# Build configuration only; physical board behavior still requires bench testing.
# CONFIG_DIGIVICE_BOARD_GENERIC_SERIAL is not set
CONFIG_DIGIVICE_BOARD_WAVESHARE_146=y
# CONFIG_DIGIVICE_BOARD_HELTEC_UNVERIFIED is not set
CONFIG_DIGIVICE_SD_ASSETS=y
CONFIG_DIGIVICE_PRIVATE_SD_ART=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=128
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_EXFAT=y
# CONFIG_DIGIVICE_QMI_PEDOMETER is not set
# CONFIG_DIGIVICE_DEVELOPMENT_ASSETS is not set
# CONFIG_DIGIVICE_ALLOW_PRIVATE_HTTP is not set

# Exact physical board, no layout/save changes. PSRAM holds only disposable pixels.
CONFIG_DIGIVICE_DISPLAY_TOUCH=y
# C13/C14 case: user confirms image bottom toward viewer left with handle down.
# Rotate the image counterclockwise; display HAL applies inverse touch mapping.
# CONFIG_DIGIVICE_DISPLAY_ORIENTATION_NATIVE is not set
# CONFIG_DIGIVICE_DISPLAY_ORIENTATION_CW90 is not set
CONFIG_DIGIVICE_DISPLAY_ORIENTATION_CCW90=y
CONFIG_DIGIVICE_AUDIO_MOTION=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY is not set
# CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY is not set
# CONFIG_SPIRAM_FETCH_INSTRUCTIONS is not set
# CONFIG_SPIRAM_RODATA is not set
