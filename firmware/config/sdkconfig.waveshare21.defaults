# Waveshare ESP32-S3 Touch LCD 2.1 Rev2: verified release configuration.
# Native USB leaves the external TX43/RX44 UART available to PN532.
# TCA9554 P7 buzzer only; PCM pins 48/38/47 are owned by RGB on this board.
# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.3.6 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_DIGIVICE_BOARD_WAVESHARE_21=y
CONFIG_DIGIVICE_NFC_UART_DIAGNOSTICS=y
CONFIG_DIGIVICE_NFC_UART_GAMEPLAY=y
CONFIG_DIGIVICE_DISPLAY_TOUCH=y
CONFIG_DIGIVICE_BUZZER_21=y
CONFIG_DIGIVICE_PRIVATE_SD_ART=y
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FATFS_EXFAT=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=128
CONFIG_FATFS_API_ENCODING_UTF_8=y
